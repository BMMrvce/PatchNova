# ─── Claude / Anthropic ───────────────────────────────────────────────────────
# Get your API key from https://console.anthropic.com/
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: override the Claude model used for analysis and chat
# Defaults to claude-haiku-4-5-20251001 if not set
# Options: claude-haiku-4-5-20251001 | claude-sonnet-4-6 | claude-opus-4-8
VITE_CLAUDE_MODEL=claude-haiku-4-5-20251001

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from your Supabase project settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
